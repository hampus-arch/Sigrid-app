{% if block.settings.enabled %}
<div id="sigrid-chat-widget-container"></div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

  #sigrid-chat-widget-container {
    position: fixed;
    bottom: {{ block.settings.position_bottom }}px;
    right: {{ block.settings.position_right }}px;
    z-index: 9999;
    font-family: -apple-system, system-ui, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Toggle Button */
  .sigrid-toggle {
    width: 56px;
    height: 56px;
    border-radius: 9999px;
    background: #064C44;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    transition: all 0.2s ease;
    position: relative;
  }

  .sigrid-toggle:hover {
    transform: scale(1.05);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.22);
  }

  .sigrid-toggle svg {
    width: 24px;
    height: 24px;
    fill: #ffffff;
    transition: transform 0.2s ease;
  }

  .sigrid-toggle.active svg.icon-chat { display: none; }
  .sigrid-toggle svg.icon-close { display: none; }
  .sigrid-toggle.active svg.icon-close { display: block; }

  /* Chat Window */
  .sigrid-window {
    position: absolute;
    bottom: 68px;
    right: 0;
    width: 414px;
    height: 562px;
    border-radius: 32px;
    display: none;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18), 0 0 0 1px rgba(0,0,0,0.03);
  }

  .sigrid-window.open {
    display: flex;
    animation: sigrid-slide-up 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes sigrid-slide-up {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Background layer with warm beige + gradient glow */
  .sigrid-bg {
    position: absolute;
    inset: 0;
    background: #F6F5ED;
    border-radius: 32px;
    overflow: hidden;
  }

  .sigrid-bg::before {
    content: '';
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: rgba(6, 76, 68, 0.7);
    filter: blur(150px);
    bottom: -60px;
    right: -20px;
    pointer-events: none;
  }

  .sigrid-bg::after {
    content: '';
    position: absolute;
    width: 380px;
    height: 380px;
    border-radius: 999px;
    background: rgba(178, 210, 193, 0.85);
    filter: blur(200px);
    bottom: -120px;
    left: -40px;
    pointer-events: none;
  }

  /* Content wrapper */
  .sigrid-content {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 20px 20px;
    z-index: 1;
  }

  /* Header */
  .sigrid-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .sigrid-logo-area {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }

  .sigrid-logo-text {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-size: 18px;
    font-weight: 600;
    font-style: italic;
    color: #064C44;
    letter-spacing: 0.02em;
  }

  .sigrid-logo-ai {
    font-family: -apple-system, system-ui, sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #064C44;
    letter-spacing: 0.01em;
  }

  .sigrid-close-btn {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.05);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
    color: #160112;
  }

  .sigrid-close-btn:hover {
    background: rgba(0, 0, 0, 0.1);
  }

  .sigrid-close-btn svg {
    width: 14px;
    height: 14px;
  }

  /* Title */
  .sigrid-title {
    font-size: 28px;
    line-height: 1.2;
    font-weight: 500;
    color: #160112;
    letter-spacing: -0.01em;
    text-align: center;
    padding: 48px 20px 0;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  /* Messages Area */
  .sigrid-messages {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 0 8px;
    margin-bottom: 12px;
  }

  .sigrid-messages::-webkit-scrollbar {
    width: 4px;
  }

  .sigrid-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .sigrid-messages::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.1);
    border-radius: 2px;
  }

  /* Message groups */
  .sigrid-msg-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sigrid-msg-group.user {
    align-items: flex-end;
  }

  .sigrid-msg-group.assistant {
    align-items: flex-start;
  }

  .sigrid-msg-label {
    font-size: 10px;
    font-weight: 500;
    color: rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 4px;
    margin-bottom: 1px;
  }

  .sigrid-msg-bubble {
    max-width: 82%;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.5;
    color: #160112;
    word-wrap: break-word;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Typing indicator */
  .sigrid-typing {
    display: flex;
    gap: 5px;
    padding: 14px 14px;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 12px;
    align-self: flex-start;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .sigrid-typing span {
    width: 6px;
    height: 6px;
    background: rgba(6, 76, 68, 0.4);
    border-radius: 9999px;
    animation: sigrid-bounce 1.2s ease-in-out infinite;
  }

  .sigrid-typing span:nth-child(2) { animation-delay: 0.15s; }
  .sigrid-typing span:nth-child(3) { animation-delay: 0.3s; }

  @keyframes sigrid-bounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  /* Quiz CTA button */
  .sigrid-quiz-cta {
    display: none;
    align-items: center;
    justify-content: space-between;
    background: rgba(6, 76, 68, 0.08);
    border: 1px solid rgba(6, 76, 68, 0.2);
    border-radius: 12px;
    padding: 10px 14px;
    margin-bottom: 8px;
    text-decoration: none;
    color: #064C44;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
  }

  .sigrid-quiz-cta:hover {
    background: rgba(6, 76, 68, 0.14);
    border-color: rgba(6, 76, 68, 0.35);
  }

  .sigrid-quiz-cta.visible {
    display: flex;
  }

  .sigrid-quiz-cta-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sigrid-quiz-cta-label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  .sigrid-quiz-cta-title {
    font-size: 13px;
    font-weight: 500;
  }

  .sigrid-quiz-cta-arrow {
    font-size: 16px;
    opacity: 0.6;
  }

  @keyframes sigrid-quiz-pulse {
    0%   { transform: scale(1); box-shadow: 0 0 0 0 rgba(6, 76, 68, 0.3); }
    50%  { transform: scale(1.02); box-shadow: 0 0 0 6px rgba(6, 76, 68, 0); }
    100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(6, 76, 68, 0); }
  }

  /* Input bar */
  .sigrid-composer {
    flex-shrink: 0;
    padding: 0 0px;
  }

  .sigrid-input-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border-radius: 24px;
    border: 1px solid rgba(22, 1, 18, 0.2);
    padding: 4px 6px 4px 18px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .sigrid-input-wrapper:focus-within {
    border-color: rgba(6, 76, 68, 0.4);
    box-shadow: 0 0 0 3px rgba(6, 76, 68, 0.06);
  }

  .sigrid-input {
    flex: 1;
    border: none;
    background: none !important;
    font-size: 14px;
    font-family: inherit;
    color: #160112;
    outline: none;
    padding: 10px 0;
    -webkit-appearance: none;
    appearance: none;
  }

  .sigrid-input::placeholder {
    color: #56637E;
  }

  .sigrid-send {
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    background: none !important;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .sigrid-send:hover {
    background: rgba(6, 76, 68, 0.08);
  }

  .sigrid-send:active {
    transform: scale(0.92);
  }

  .sigrid-send:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .sigrid-send svg {
    width: 18px;
    height: 18px;
  }

  /* Mobile */
  @media (max-width: 480px) {
    .sigrid-window {
      width: calc(100vw - 24px);
      height: calc(100vh - 100px);
      bottom: 68px;
      right: -{{ block.settings.position_right | minus: 12 }}px;
      border-radius: 20px;
    }

    .sigrid-title {
      font-size: 24px;
      padding: 32px 12px 0;
    }
  }
</style>

<script>
(function() {
  var API_URL = '{{ block.settings.api_url }}';
  var QUIZ_URL = '{{ block.settings.quiz_url }}';
  var SESSION_ID = 'sigrid_' + Math.random().toString(36).substr(2, 9) + '_' + Date.now();

  var container = document.getElementById('sigrid-chat-widget-container');
  container.innerHTML =
    '<button class="sigrid-toggle" aria-label="Open chat">' +
      '<svg class="icon-chat" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg>' +
      '<svg class="icon-close" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>' +
    '</button>' +
    '<div class="sigrid-window">' +
      '<div class="sigrid-bg"></div>' +
      '<div class="sigrid-content">' +
        '<div class="sigrid-header">' +
          '<div class="sigrid-logo-area">' +
            '<span class="sigrid-logo-text">SIGRID</span>' +
            '<span class="sigrid-logo-ai">AI</span>' +
          '</div>' +
          '<button class="sigrid-close-btn" aria-label="Close">' +
            '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>' +
          '</button>' +
        '</div>' +
        '<div class="sigrid-title">Ask our AI anything</div>' +
        '<div class="sigrid-messages"></div>' +
        '<button class="sigrid-quiz-cta" type="button">' +
          '<div class="sigrid-quiz-cta-text">' +
            '<span class="sigrid-quiz-cta-label">Not sure?</span>' +
            '<span class="sigrid-quiz-cta-title">Find out if SIGRID is right for you</span>' +
          '</div>' +
          '<span class="sigrid-quiz-cta-arrow">→</span>' +
        '</button>' +
        '<div class="sigrid-composer">' +
          '<div class="sigrid-input-wrapper">' +
            '<input type="text" class="sigrid-input" placeholder="Talk to our expert!" />' +
            '<button class="sigrid-send" aria-label="Send">' +
              '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.5 19.5L19.5 12L4.5 4.5L4.5 10.5L13.5 12L4.5 13.5L4.5 19.5Z" fill="#064C44"/></svg>' +
            '</button>' +
          '</div>' +
        '</div>' +
      '</div>' +
    '</div>';

  var isOpen = false;
  var toggle = container.querySelector('.sigrid-toggle');
  var closeBtn = container.querySelector('.sigrid-close-btn');
  var chatWindow = container.querySelector('.sigrid-window');
  var messagesEl = container.querySelector('.sigrid-messages');
  var input = container.querySelector('.sigrid-input');
  var sendBtn = container.querySelector('.sigrid-send');
  var quizCta = container.querySelector('.sigrid-quiz-cta');

  // Load Typeform embed SDK if quiz is configured
  var tfPopup = null;
  if (QUIZ_URL) {
    quizCta.classList.add('visible');

    var tfCss = document.createElement('link');
    tfCss.rel = 'stylesheet';
    tfCss.href = '//embed.typeform.com/next/css/popup.css';
    document.head.appendChild(tfCss);

    var tfScript = document.createElement('script');
    tfScript.src = '//embed.typeform.com/next/embed.js';
    document.head.appendChild(tfScript);
  }

  function openTypeformPopup() {
    if (!QUIZ_URL || !window.tf) return;
    if (!tfPopup) {
      tfPopup = window.tf.createPopup(QUIZ_URL, {
        onSubmit: function(payload) {
          // Log quiz submission to Klaviyo via API
          fetch(API_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'quiz_submitted',
              sessionId: SESSION_ID,
              typeformResponseId: payload.responseId
            })
          }).catch(function() {});
        }
      });
    }
    tfPopup.open();
  }

  quizCta.addEventListener('click', openTypeformPopup);

  function toggleChat() {
    isOpen = !isOpen;
    chatWindow.classList.toggle('open', isOpen);
    toggle.classList.toggle('active', isOpen);
    if (isOpen) input.focus();
  }

  toggle.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);

  function addMessage(content, role) {
    var group = document.createElement('div');
    group.className = 'sigrid-msg-group ' + role;

    var label = document.createElement('div');
    label.className = 'sigrid-msg-label';
    label.textContent = role === 'user' ? 'YOU' : 'SIGRID AI';

    var bubble = document.createElement('div');
    bubble.className = 'sigrid-msg-bubble';
    bubble.textContent = content;

    group.appendChild(label);
    group.appendChild(bubble);
    messagesEl.appendChild(group);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function showTyping() {
    var typing = document.createElement('div');
    typing.className = 'sigrid-typing';
    typing.id = 'sigrid-typing';
    typing.innerHTML = '<span></span><span></span><span></span>';
    messagesEl.appendChild(typing);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function hideTyping() {
    var typing = document.getElementById('sigrid-typing');
    if (typing) typing.remove();
  }

  // Show quiz CTA prominently and auto-open popup when agent suggests quiz
  function handleQuizSuggested() {
    if (!QUIZ_URL) return;
    quizCta.classList.add('visible');
    // Pulse animation to draw attention
    quizCta.style.animation = 'none';
    quizCta.offsetHeight; // reflow
    quizCta.style.animation = 'sigrid-quiz-pulse 0.6s ease';
    // Auto-open the Typeform popup after a short delay so user can read the message
    setTimeout(function() {
      openTypeformPopup();
    }, 1800);
  }

  async function sendMessage() {
    var text = input.value.trim();
    if (!text) return;

    input.value = '';
    sendBtn.disabled = true;

    addMessage(text, 'user');
    showTyping();

    try {
      var res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, sessionId: SESSION_ID })
      });

      hideTyping();

      if (res.ok) {
        var data = await res.json();
        addMessage(data.response || 'No response received.', 'assistant');

        // If the agent suggested the quiz, highlight the CTA
        if (data.suggestedQuiz && QUIZ_URL) {
          handleQuizSuggested();
        }
      } else {
        addMessage('Something went wrong. Please try again.', 'assistant');
      }
    } catch (e) {
      hideTyping();
      console.error('Sigrid chat error:', e);
      addMessage('Could not connect. Please try again.', 'assistant');
    }

    sendBtn.disabled = false;
    input.focus();
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') sendMessage();
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Sigrid Chat Widget",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable chat widget",
      "default": true
    },
    {
      "type": "url",
      "id": "api_url",
      "label": "API URL",
      "info": "The URL to the Sigrid chat API endpoint, e.g. https://sigrid-chat-widget.vercel.app/api/chat"
    },
    {
      "type": "url",
      "id": "quiz_url",
      "label": "Typeform Quiz URL",
      "info": "Your Typeform quiz link. When set, a 'Find out if SIGRID is right for you' button is shown — and highlighted when the AI suggests the quiz."
    },
    {
      "type": "range",
      "id": "position_bottom",
      "label": "Position bottom (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "position_right",
      "label": "Position right (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 25
    }
  ]
}
{% endschema %}
